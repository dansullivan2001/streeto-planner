# Copy this file to .env (already gitignored) and fill in the keys you have.
# Neither is required: without them, distances fall back to the approximation.

OPENROUTESERVICE_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Optional: set to require a shared password on the Streamlit app. Leave
# blank for local use. Set before any deployment reachable from the open
# internet.
STREETO_APP_PASSWORD=
